{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FM Watcher",
  "version": "0.1.0",
  "identifier": "com.fmwatcher.desktop",
  "build": {
    "frontendDist": "http://localhost:3030",
    "devUrl": "http://localhost:3030",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File build_standalone.ps1"
  },
  "app": {
    "windows": [
      {
        "title": "FM Watcher",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../.next/standalone/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
